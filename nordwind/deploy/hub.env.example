# Copy to hub.env (git-ignored) and fill in. See nordwind/docs/RUNBOOK-nordwind.md.
NW_CP_URL=https://bunsenbrenner.org
NW_OIDC_ISSUER=https://auth.bunsenbrenner.org/realms/ct-demo
# service account that OWNS the Nordwind topology (portal -> Service accounts)
NW_CP_CLIENT_ID=
NW_CP_CLIENT_SECRET=
# optional: pin a topology id when the account has several
NW_TOPOLOGY_ID=
# tunnel agent for a2a-demo.bunsenbrenner.org
A2A_AGENT_EDGE=edge:4433
NW_JOIN_TOKEN=
PLANE_NETWORK=ct-selfhost_default
